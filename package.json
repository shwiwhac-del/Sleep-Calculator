{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "build:blog": "esbuild scripts/generate-blog-static.ts --bundle --platform=node --format=cjs --target=node22 --outfile=scripts/generate-blog-static.cjs && node scripts/generate-blog-static.cjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --external:express",
    "build": "npm run build:blog && vite build && npx tsx scripts/generate-static-html-pages.ts && npm run build:server",
    "preview": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "firebase": "^12.13.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.1",
    "vite": "^6.2.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-css-injected-by-js": "^5.0.1"
  }
}
